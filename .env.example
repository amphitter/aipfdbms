# AIPF Mission Hospital — environment checklist
#
# The application does not load this file. It reads the process environment only.
# Copy the values you need into the shell before starting the server.
#
# Bash:
#   set -a
#   source .env.example
#   set +a
#
# PowerShell does not source this file. Set each variable with $env:NAME = "value".

# development (default) or production.
# production refuses to start unless AIPF_DATABASE_URL is a PostgreSQL URL.
AIPF_ENV=development

# Required for `python3 -m aipf.server`.
# start-host.sh sets a sqlite URL only when this variable is empty.
# Use postgresql:// or postgres:// for PostgreSQL.
# Use sqlite:///absolute/path/hospital.db only for local SQLite development.
AIPF_DATABASE_URL=postgresql://aipf:your-password@127.0.0.1:5432/aipf_dev

# Optional. Default is 8787. The Vite desk proxies /api to 127.0.0.1:8787.
AIPF_PORT=8787

# Required only the first time a database has no users.
# Minimum 12 characters. Not stored in the repository. Same value is used for every seeded account.
AIPF_SEED_PASSWORD=CHANGE_ME_at_least_12

# Test-only. Not read by the hospital server.
# Acceptance tests that need PostgreSQL connect here and CREATE/DROP their own databases.
# The role must be allowed to create and drop databases. Do not point this at production.
# AIPF_TEST_POSTGRES=postgresql://aipf:your-password@127.0.0.1:5432/postgres

# Test-only. Set to 1 to make a skipped Phase 1, 2, or 3 HTTP test fail instead of return.
# PHASE1_REQUIRE_POSTGRES=1
# PHASE2_REQUIRE_POSTGRES=1
# PHASE3_REQUIRE_POSTGRES=1
